NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://decoho-fe.vercel.app

# Local: mongodb://127.0.0.1:27017/DecohoDB
# Render: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DecohoDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/DecohoDB

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_EMAIL_VERIFICATION_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_EXPIRES_IN=1d
JWT_PASSWORD_RESET_SECRET=replace-with-a-third-long-random-secret
JWT_PASSWORD_RESET_EXPIRES_IN=15m
PASSWORD_SALT_ROUNDS=12

GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
CLOUDINARY_FOLDER=decoho
CLOUDINARY_ROOMS_FOLDER=decoho/rooms

EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPOSE_TOKEN=true
PASSWORD_RESET_URL=http://localhost:3000/reset-password
